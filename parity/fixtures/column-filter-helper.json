      "action": { "name": "filter-helper-probe" },
      "stateMutations": [{ "path": "filterHelperProbe", "value": "{\"kind\":\"text\",\"operator\":\"contains\",\"rawValue\":\"hello\",\"displayString\":\"hello\",\"ruleValue\":\"world\"}" }],
      "expectBodyContains": ["FilterHelperProbeResult=false"]
    },
