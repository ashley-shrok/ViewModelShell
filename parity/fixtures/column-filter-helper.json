      "action": { "name": "filter-helper-probe" },
      "stateMutations": [{ "path": "filterHelperProbe", "value": "{\"kind\":\"text\",\"operator\":\"contains\",\"rawValue\":\"hello world\",\"displayString\":\"hello world\",\"ruleValue\":\"world\"}" }],
      "expectBodyContains": ["FilterHelperProbeResult=true"]
    },
    {
      "id": "text-contains-no-match",
